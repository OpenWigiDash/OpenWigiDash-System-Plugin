@using OpenWigiDash.SystemPlugin.Apps
@using Microsoft.AspNetCore.Components.Forms
@using OpenWigiDash.SystemPlugin.Rendering
@inherits WidgetSettingsComponent<OpenApplicationInstance>
@implements IDisposable

@* Tela de configurações do Open Application, com os mesmos campos do plugin System do Stream Deck. *@
<MudStack Spacing="4">
    <MudTextField T="string" Value="@Instance.Title" ValueChanged="v => Instance.SetTitleAsync(v)" Label="Título"
                  Variant="Variant.Outlined" Immediate="false" Clearable="true"
                  HelperText="Texto embaixo do ícone. Vazio = só o ícone." />

    <MudStack Row="true" AlignItems="AlignItems.Center">
        @if (Instance.App is { } chosen)
        {
            @* Ícone do app escolhido ao lado do nome. *@
            @if ((Instance.CustomIconDataUrl ?? IconFor(chosen)) is { } chosenIcon)
            {
                <img src="@chosenIcon" width="40" height="40" alt="" style="flex:none" />
            }
            else
            {
                <span style="display:inline-block;width:40px;height:40px;flex:none"></span>
            }
        }
        <MudAutocomplete T="AppChoice" Value="Instance.App" ValueChanged="SelectApp" Label="App"
                         Variant="Variant.Outlined" SearchFunc="Search" ToStringFunc="@(a => a?.Name)"
                         MaxItems="null" ResetValueOnEmptyText="false" Clearable="true"
                         Disabled="@(_apps is null)" Style="min-width: 320px"
                         HelperText="@_status">
            <ItemTemplate Context="app">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @if (IconFor(app) is { } url)
                    {
                        <img src="@url" width="20" height="20" alt="" />
                    }
                    else
                    {
                        <span style="display:inline-block;width:20px;height:20px"></span>
                    }
                    <MudText Typo="Typo.body2">@app.Name</MudText>
                </MudStack>
            </ItemTemplate>
        </MudAutocomplete>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="ReloadApps" aria-label="Ler a lista de apps de novo" />
    </MudStack>

    <MudTextField T="string" Value="@Instance.Arguments" ValueChanged="v => Instance.SetArgumentsAsync(v)" Label="Argumentos"
                  Variant="Variant.Outlined" Immediate="false" Clearable="true"
                  Placeholder="ex.: /v:MEU-PC /f"
                  HelperText="Do jeito que iriam na linha de comando; aceita %USERPROFILE%. Com argumentos, o app abre direto pelo exe (ou ativado, se for da Store). Vários tiles do mesmo app com argumentos diferentes (RDP para PCs diferentes): desmarque “Trazer para a frente”." />

    <MudStack Spacing="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (Instance.CustomIconDataUrl is { } custom)
            {
                <img src="@custom" width="40" height="40" alt="" style="flex:none;object-fit:contain" />
            }
            <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-default mud-button-outlined-size-medium" style="cursor:pointer">
                <span class="mud-button-label">@(Instance.CustomIconFileId is null ? "Escolher ícone do PC…" : "Trocar ícone…")</span>
                <InputFile OnChange="UploadIcon" accept="@CustomIconFile.Accept" style="display:none" />
            </label>
            @if (Instance.CustomIconFileId is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="ClearIcon">Usar o ícone do app</MudButton>
            }
            @if (_iconBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
        </MudStack>
        <MudText Typo="Typo.caption" Color="@(_iconError is null ? Color.Secondary : Color.Error)">
            @(_iconError ?? "Imagem (.png, .jpg, .bmp, .gif) ou o ícone de um .ico, .exe ou .dll. Fica no lugar do ícone do app.")
        </MudText>
    </MudStack>

    <MudSelect T="IconFit" Value="Instance.IconFit" ValueChanged="v => Instance.SetIconFitAsync(v)"
               Label="Ícone" Variant="Variant.Outlined">
        <MudSelectItem Value="IconFit.Fill">Preencher o tile (sem cortar o ícone)</MudSelectItem>
        <MudSelectItem Value="IconFit.Cover">Cobrir o tile todo (corta as bordas no Mini)</MudSelectItem>
        <MudSelectItem Value="IconFit.Padded">Com margem</MudSelectItem>
    </MudSelect>

    <BackgroundColorField Value="@Instance.Background" ValueChanged="v => Instance.SetBackgroundAsync(v)"
                          HelperText="Padrão = preto, ou a cor da placa do ícone (ex.: verde do Xbox)." />

    <MudSelect T="LongPressAction" Value="Instance.LongPress" ValueChanged="v => Instance.SetLongPressAsync(v)"
               Label="Long press" Variant="Variant.Outlined">
        <MudSelectItem Value="LongPressAction.DoNothing">Não fazer nada</MudSelectItem>
        <MudSelectItem Value="LongPressAction.Quit">Fechar o app</MudSelectItem>
        <MudSelectItem Value="LongPressAction.ForceQuit">Forçar o fechamento</MudSelectItem>
    </MudSelect>

    <MudCheckBox T="bool" Value="Instance.BringToFront" ValueChanged="v => Instance.SetBringToFrontAsync(v)" Color="Color.Primary">
        Trazer para a frente se já estiver aberto
    </MudCheckBox>

    @if (Instance.App is not null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small"
                     Color="@(Instance.State.IsRunning ? Color.Success : Color.Default)" />
            <MudText Typo="Typo.body2">@StateText</MudText>
        </MudStack>
        @if (Instance.Target is { } target)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="word-break: break-all">
                @LaunchText(target)
            </MudText>
        }
    }
</MudStack>

@code {
    private IReadOnlyList<AppChoice>? _apps;
    private string _status = "Lendo os apps do menu Iniciar...";
    private Timer? _redraw;
    private Task? _warm;
    private volatile bool _dirty;

    private string StateText =>
        Instance.IsMissing ? "O app não está mais no menu Iniciar (desinstalado?)"
        : Instance.State.IsRunning ? "Aberto agora"
        : "Fechado";

    protected override async Task OnInitializedAsync()
    {
        Instance.Changed += OnChanged;
        // Redesenha no máximo a cada 150 ms enquanto os ícones chegam, não uma vez por ícone.
        _redraw = new Timer(_ =>
        {
            if (_dirty || _warm is { IsCompleted: false })
            {
                _dirty = false;
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, 150, 150);
        await LoadAppsAsync(refresh: false);
    }

    private async Task LoadAppsAsync(bool refresh)
    {
        try
        {
            _apps = await AppCatalog.GetListAsync(refresh);
            _status = $"{_apps.Count} apps do menu Iniciar, incluindo os da Microsoft Store.";
            _warm = AppCatalog.WarmAsync();
            _ = _warm.ContinueWith(_ => _dirty = true, TaskScheduler.Default);
        }
        catch (Exception ex)
        {
            _apps = [];
            _status = "Não deu para ler os apps: " + ex.Message;
        }
    }

    private async Task ReloadApps()
    {
        _apps = null;
        _status = "Lendo os apps do menu Iniciar...";
        await LoadAppsAsync(refresh: true);
    }

    private Task<IEnumerable<AppChoice>> Search(string? text, CancellationToken cancellationToken)
    {
        IEnumerable<AppChoice> apps = _apps ?? [];
        if (!string.IsNullOrWhiteSpace(text) && !string.Equals(text, Instance.App?.Name, StringComparison.CurrentCulture))
            apps = apps.Where(a => a.Name.Contains(text, StringComparison.CurrentCultureIgnoreCase));
        return Task.FromResult(apps);
    }

    /// <summary>O que o toque abre: o exe ou o AUMID, e com argumentos, a linha de comando inteira.</summary>
    private string LaunchText(AppTarget target)
    {
        if (string.IsNullOrWhiteSpace(Instance.Arguments) || Instance.App is not { } app)
            return target.ExePath ?? target.Aumid ?? target.Id;
        var plan = AppLaunch.Plan(app, target, Instance.Arguments);
        return plan.Kind == LaunchKind.StartMenu
            ? "Sem exe conhecido: abre pelo Iniciar, que pode ignorar os argumentos."
            : $"{plan.File} {plan.Arguments}";
    }

    private Task SelectApp(AppChoice? app) => Instance.SetAppAsync(app);

    private bool _iconBusy;
    private string? _iconError;

    /// <summary>Um .exe pode ser grande; o que importa dele é só o ícone.</summary>
    private const long MaxIconFileSize = 256L * 1024 * 1024;

    private async Task UploadIcon(InputFileChangeEventArgs e)
    {
        _iconError = null;
        if (e.File.Size > MaxIconFileSize)
        {
            _iconError = "Arquivo grande demais (máximo 256 MB). Para um jogo, escolha um .ico ou uma imagem.";
            return;
        }
        _iconBusy = true;
        // Mantém a extensão: é por ela que se sabe se é imagem ou arquivo com ícone (.ico, .exe, .dll).
        var temp = Path.Combine(Path.GetTempPath(), "openwigidash-" + Guid.NewGuid().ToString("N") + Path.GetExtension(e.File.Name));
        try
        {
            await using (var target = File.Create(temp))
            await using (var source = e.File.OpenReadStream(maxAllowedSize: MaxIconFileSize))
                await source.CopyToAsync(target);
            await Instance.SetCustomIconAsync(temp);
        }
        catch (Exception ex)
        {
            _iconError = "Não deu para usar esse arquivo: " + ex.Message;
        }
        finally
        {
            _iconBusy = false;
            try { File.Delete(temp); } catch (IOException) { }
        }
    }

    private async Task ClearIcon()
    {
        _iconError = null;
        await Instance.ClearCustomIconAsync();
    }

    /// <summary>Ícone já carregado, ou <c>null</c> e pede (as linhas visíveis passam na frente da pré-carga).</summary>
    private string? IconFor(AppChoice app)
    {
        if (AppIcons.TryGetDataUrl(app.Id, out var url))
            return url;
        _ = AppIcons.GetDataUrlAsync(app.Id).ContinueWith(_ => _dirty = true, TaskScheduler.Default);
        return null;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Instance.Changed -= OnChanged;
        _redraw?.Dispose();
    }
}
